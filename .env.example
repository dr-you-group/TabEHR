# Copy to .env, fill in, and keep it out of git (.gitignore already excludes it).
# The variable names are the ones SparseArray already uses, so one .env serves
# both. The config files under config/ refer to them as "env:NAME".

# Connection
SPARSE_ARRAY_DBMS='sql server'
SPARSE_ARRAY_DB_SERVER=''
SPARSE_ARRAY_DB_PORT='1433'
SPARSE_ARRAY_DB_USER=''
SPARSE_ARRAY_DB_PASSWORD=''
# Optional JDBC connection parameters, for example PostgreSQL session settings.
SPARSE_ARRAY_DB_EXTRA_SETTINGS=''
# Leave empty to use the JDBC driver installed in the image.
SPARSE_ARRAY_JDBC_FOLDER=''

# Schemas. The cohort schema must be writable: the cohort table and every
# table this project creates (prefix tabehr_) live there.
SPARSE_ARRAY_CDM_DATABASE_SCHEMA=''
SPARSE_ARRAY_VOCABULARY_DATABASE_SCHEMA=''
SPARSE_ARRAY_COHORT_DATABASE_SCHEMA=''
SPARSE_ARRAY_COHORT_TABLE='cohort_v3'

# Folders
# Docker host folder. Windows example: D:/TabEHR-storage/files
TABEHR_STORAGE_HOST_FOLDER='./data/storage'
# Paths inside the container. For native R, use paths on that machine instead.
TABEHR_OUTPUT_FOLDER='/home/rstudio/storage/output'
TABEHR_ANDROMEDA_TEMP_FOLDER='/home/rstudio/storage/andromeda'
TABEHR_R_TEMP_FOLDER='/home/rstudio/storage/tmp'
# SPARSE_ARRAY_ANDROMEDA_TEMP_FOLDER remains supported as a fallback.

# RStudio password for the container
FEATURE_EXTRACTION_V3_RSTUDIO_PASSWORD='change-me'
