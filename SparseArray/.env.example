# Copy to .env, choose a private password, and run chmod 600 .env.
FEATURE_EXTRACTION_V3_RSTUDIO_PASSWORD='change-me'

SPARSE_ARRAY_ANDROMEDA_TEMP_FOLDER='/home/rstudio/feature_extraction_v3/data/andromeda'
SPARSE_ARRAY_OUTPUT_FOLDER='/home/rstudio/feature_extraction_v3/output'

# Leave empty to use the temporal sequence settings installed with the package,
# or point at a JSON file written by extras/CreateCovariateSettings.R.
SPARSE_ARRAY_COVARIATE_SETTINGS_FILE=''

# Leave empty to use the JDBC driver installed in the image, or point at a
# mounted folder such as /home/rstudio/feature_extraction_v3/jdbc.
SPARSE_ARRAY_JDBC_FOLDER=''

SPARSE_ARRAY_DB_SERVER=''
SPARSE_ARRAY_DB_PORT='1433'
SPARSE_ARRAY_DB_USER=''
SPARSE_ARRAY_DB_PASSWORD=''

SPARSE_ARRAY_CDM_DATABASE_SCHEMA=''
SPARSE_ARRAY_COHORT_DATABASE_SCHEMA=''
SPARSE_ARRAY_COHORT_TABLE='cohort_v3'
SPARSE_ARRAY_BATCH_SIZE='1000000'
